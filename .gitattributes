# 统一用 LF 存文本，避免 Windows/Linux 之间来回改行尾
* text=auto eol=lf

# 明确标记二进制，别让 git 去猜（也就不会被当成文本做行尾转换）
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.dat   binary
*.zip   binary
*.bin   binary

# 补丁文件要按 CRLF 检出：AWTK 子模块里的文件是 CRLF，补丁的上下文行也必须 CRLF
# 才能被 git apply 干净匹配（build_awtk.ps1 另外还加了 --ignore-whitespace 兜底）
patches/*.patch  text eol=crlf

# NSIS 脚本与 C 源码按 LF 处理
*.nsi   text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.ps1   text eol=lf
*.md    text eol=lf
*.ini   text eol=lf
